# Disposable demo credential for the local-only lab database.
# "labpass" is a published constant for a throwaway PostgreSQL that
# tools/bootstrap.mjs creates on 127.0.0.1:54399 and seeds with sample
# blog data. It protects nothing else; never reuse it anywhere else.
# Copy this file to .env before running the app commands:
#   cp app/.env.example app/.env
DATABASE_URL=postgresql://postgres:labpass@127.0.0.1:54399/lab
